/*
 * The port's own resources (the original's menus, dialogs and pictures are
 * read from the user's original binary at runtime). Single launch and the
 * document types it opens, as the original's BEOS:APP_FLAGS and
 * BEOS:FILE_TYPES (less the parts not ported yet); its own signature so it
 * doesn't take the original's.
 */

resource app_signature "application/x-vnd.gobe-port.productive";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 1,
	variety = B_APPV_DEVELOPMENT,
	internal = 1,
	short_info = "Gobe Productive for Haiku",
	long_info = "A port of Gobe Productive 2.0.1 to 64-bit Haiku (preview). It needs the original Gobe Productive."
};

resource file_types message {
	"types" = "application/x-vnd.gobe.productive-document",
	"types" = "text"
};
