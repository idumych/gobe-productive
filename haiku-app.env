# haiku-app.env — what the beos-app-platforms release tools need to know about this app.
# Shell syntax: sourced by packaging/*.sh, the CI workflow and the
# release scripts (check-artifact.sh, release-gate.sh). Keep values quoted; no spaces around '='.

# ── Identity ──
APP_NAME="GobeProductive"              # binary name = window/team name
APP_CMD="gobeproductive"               # package name and command, lowercase (no '-' or '_':
                                       # valid as both a Haiku and a Debian package name)
APP_SIG="application/x-vnd.gobe-port.productive"   # must equal the .rdef app_signature
RDEF="GobeProductive.rdef"             # path of the resource definition

# ── Version (also in the .rdef app_version and packaging/debian/changelog) ──
VERSION="0.1.0"
REVISION="1"

# ── Package metadata ──
SUMMARY="Gobe Productive 2.0.1, the BeOS office suite, ported (preview; needs the original)"
DESCRIPTION_FILE="packaging/description.txt"   # plain text; blank line = paragraph
HOMEPAGE="https://github.com/idumych/gobe-productive"
GITHUB_REPO="idumych/gobe-productive"
LICENSE_NAME="MIT"                     # a name from /boot/system/data/licenses on Haiku
COPYRIGHT="2026 the Gobe Productive port contributors"
PACKAGER="Ian <idumych@gmail.com>"

# Extra runtime dependencies beyond the Haiku API itself
HPKG_REQUIRES_EXTRA="lib:libz"
DEB_DEPENDS_EXTRA="zlib1g"
DEB_SECTION="editors"
DESKTOP_CATEGORIES="Office;WordProcessor;"
APPIMAGE_MUST_BUNDLE=""                # zlib is on every Linux system (linuxdeploy's
                                       # excludelist leaves it out)
# The documents' Bitstream fonts are shown in the Liberation fonts (metric
# compatible with Times, Helvetica, Courier); Noto when they're missing
APPIMAGE_FONTS_EXTRA="LiberationSerif-Regular LiberationSerif-Bold LiberationSerif-Italic LiberationSerif-BoldItalic LiberationSans-Regular LiberationSans-Bold LiberationSans-Italic LiberationSans-BoldItalic LiberationMono-Regular LiberationMono-Bold LiberationMono-Italic LiberationMono-BoldItalic"
COSMOE_REPO=""                         # "" = idumych/hokku
COSMOE_TAG=""                          # "" = hokku
APPIMAGE_APT_EXTRA="zlib1g-dev fonts-liberation"
DEB_APT_EXTRA="zlib1g-dev"

# ── Build ──
HPKG_BUILD_DEPS="zlib_devel"
TEST_CMD="make test"                   # the portable core's tests (the rest need the original)
TYPECHECK_SRCS="src/app/GobeResources.cpp src/app/TApp.cpp src/app/TDialog.cpp src/app/TDialogNewDoc.cpp src/app/TDialogSplash.cpp src/app/TDocumentDialogs.cpp src/app/TDocView.cpp src/app/TDocWindow.cpp src/app/TFindDialog.cpp src/app/TFormatBar.cpp src/app/TMenu.cpp src/app/TPageBar.cpp src/app/TPageEdit.cpp src/app/TPageView.cpp src/app/TPartBar.cpp src/app/TPreferences.cpp src/app/TRecentDocs.cpp src/app/TRibbon.cpp src/app/TSpellBar.cpp src/app/TSpellDialogs.cpp src/app/TStylesEdit.cpp src/app/TTranslate.cpp src/app/TWindowArrange.cpp src/app/TWPDialogs.cpp src/app/TWPRuler.cpp"
TYPECHECK_INCLUDES="src/core src/app"

# ── Feature test (the app-specific part of release/test-plan.md) ──
FEATURE_CHECKS="open-document type-save-reopen edit-styles"
EVIDENCE_1="{p}-open.txt|Ernie|Objective|Qualifications"
EVIDENCE_2="{p}-reopen.txt|hello from {p}"
EVIDENCE_3="{p}-styles.txt|Available Styles"
